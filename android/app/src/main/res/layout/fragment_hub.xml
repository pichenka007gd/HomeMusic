<?xml version="1.0" encoding="utf-8"?>
<!-- HomeMusic Hub tab: native section tabs over the Hub PWA in a WebView. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/hub_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Colors of the app's theme: the page gets the same background (HubWebHolder.applyTheme), so the tabs,
         the page and the player read as one surface in both themes. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Landscape has no bottom navigation and the Hub no toolbar: this opens the drawer. -->
        <ImageButton
            android:id="@+id/hub_menu_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/homemusic_open_menu"
            android:src="@drawable/ic_homemusic_menu"
            android:visibility="gone" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/hub_tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/colorSurface"
            app:tabGravity="center"
            app:tabIndicatorColor="?attr/colorPrimary"
            app:tabMode="auto"
            app:tabPaddingEnd="8dp"
            app:tabPaddingStart="8dp"
            app:tabSelectedTextColor="?attr/colorOnSurface"
            app:tabTextColor="?attr/colorOnSurfaceVariant"
            app:tabUnboundedRipple="false" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/hub_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:trackThickness="2dp" />

    <FrameLayout
        android:id="@+id/hub_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/hub_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/hub_error_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hub_retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/homemusic_retry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hub_settings_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/homemusic_open_settings" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
